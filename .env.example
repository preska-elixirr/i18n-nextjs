# Copy to .env and replace the secret with a random string of at least 32 characters.
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
# MongoDB Atlas connection string (Connect > Drivers > Node.js). Put the database
# name after ".net/", here "atelier"; without it MongoDB writes to a "test" database.
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/atelier?retryWrites=true&w=majority&appName=Cluster0
# never: stable visible URLs, always: /en and /hr prefixes. Restart after changing.
NEXT_PUBLIC_LOCALE_PREFIX=never
